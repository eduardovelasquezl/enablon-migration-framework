# Copiar a ".env" y rellenar con credenciales reales. ".env" NUNCA se sube a git
# (ver .gitignore). Las conexiones son de solo lectura — confirmar con el DBA
# que el usuario SQL usado aquí no tiene permisos de escritura, como
# salvaguarda adicional a la de config/databases.yaml.

# --- SQL Server: sistema ITP/Prevención ---
SQL_PREVENCION_HOST=
SQL_PREVENCION_DB=Prevencion
SQL_PREVENCION_USER=
SQL_PREVENCION_PASSWORD=

# --- SQL Server: sistema GCT (MOC) ---
SQL_GCT_HOST=
SQL_GCT_DB=
SQL_GCT_USER=
SQL_GCT_PASSWORD=

# --- Enablon (para cuando se automatice validación de catálogos en vivo / API) ---
ENABLON_BASE_URL=
ENABLON_API_TOKEN=

# --- General ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Workspace externo de datos (Sprint 7 -- Workspace Separation) ---
# Raíz del workspace de datos de migración (ETL, CSV reales de Enablon,
# mappings, catálogos, evidencias) -- SIEMPRE fuera del repositorio, nunca
# subida a git. Este es solo un ejemplo de forma: cada desarrollador usa
# su propia ubicación real en su propio ".env" (nunca en este fichero, que
# sí se versiona). Ver docs/01-architecture/external-data-workspace.md.
# Ejemplo (Windows): EMF_DATA_ROOT=C:\Users\<tu-usuario>\Desktop\Migracion_Enablon_Data
EMF_DATA_ROOT=
