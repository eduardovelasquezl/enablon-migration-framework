# Secretos — nunca subir
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Datos — pueden ser pesados y/o sensibles (datos reales del cliente)
# Carpeta de recepción bruta del cliente -- ficheros que superan el límite
# de tamaño de GitHub (varios .xlsx/.csv >90MB). Se conserva localmente,
# nunca en el repositorio.
inputs/_incoming_claude_web/

inputs/etl/*
!inputs/etl/.gitkeep
inputs/csv_enablon/*
!inputs/csv_enablon/.gitkeep
inputs/mappings/*
!inputs/mappings/.gitkeep
inputs/entity_catalog/*
!inputs/entity_catalog/.gitkeep
inputs/incidents/*
!inputs/incidents/.gitkeep

outputs/*
!outputs/**/.gitkeep

logs/*
!logs/.gitkeep

sql/generated/*
!sql/generated/.gitkeep

# Sprint 7 -- Workspace Separation (ver
# docs/01-architecture/external-data-workspace.md). El workspace externo
# de datos vive FUERA del repositorio (EMF_DATA_ROOT) -- estas reglas son
# una salvaguarda adicional por si, por error, alguien copia datos reales
# o crea el workspace dentro del árbol del repo. No se ignoran todos los
# .csv/.xlsx de forma indiscriminada (existen fixtures pequeños y
# plantillas versionables) -- reglas específicas por extensión de riesgo
# alto y por nombre de carpeta.
*.bak
*.BAK
*.zip
*.ZIP
Migracion_Enablon_Data/
migracion_enablon_data/

# OS / editor
.DS_Store
.vscode/
.idea/
